DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/leadtrace?schema=public"
# Required in production; empty = in-memory dev fallback (single instance only)
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Secret wake path slug — /__wake-<slug>. Never linked in-app. Rotate after use.
LOCKDOWN_WAKE_SLUG=
DEFAULT_PHONE_REGION=US
PORT=3000
CORS_ORIGIN=https://your-frontend.example.com
