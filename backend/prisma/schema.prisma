generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Roles & permissions — everything hangs off this (spec §3)
// ─────────────────────────────────────────────────────────────

model Role {
  id          Int          @id @default(autoincrement())
  roleCode    String       @unique @map("role_code")
  displayName String       @map("display_name")
  tier        Int?
  createdAt   DateTime     @default(now()) @map("created_at")
  permissions Permission[]
  users       User[]

  @@map("roles")
}

enum PermissionScope {
  ALL
  OWN
  ASSIGNED
  VIEW

  @@map("permission_scope")
}

model Permission {
  id            Int             @id @default(autoincrement())
  roleId        Int             @map("role_id")
  permissionKey String          @map("permission_key")
  allowed       Boolean         @default(false)
  scope         PermissionScope @default(ALL)
  role          Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@map("permissions")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  // Personal batch ID — typed into the Session box on a colleague's screen to
  // work as yourself for a short admin-set window without a logout/login.
  batchId      String?  @unique @map("batch_id")
  roleId       Int      @map("role_id")
  reportsToId  Int?     @map("reports_to")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  role      Role   @relation(fields: [roleId], references: [id])
  reportsTo User?  @relation("UserReports", fields: [reportsToId], references: [id])
  reports   User[] @relation("UserReports")

  createdLeads   Lead[]           @relation("LeadCreator")
  assignedLeads  Lead[]           @relation("LeadAssignee")
  activities     Activity[]
  notifications  Notification[]
  raisedQueue    RoutingQueue[]   @relation("QueueRaisedBy")
  routedQueue    RoutingQueue[]   @relation("QueueRoutedBy")
  receivedQueue  RoutingQueue[]   @relation("QueueRoutedTo")
  enrichments    LeadEnrichment[]
  dncEntries     DncOptout[]
  comments       LeadComment[]
  accessBlocks   LeadAccessBlock[] @relation("BlockedUser")
  blocksIssued   LeadAccessBlock[] @relation("BlockedBy")
  deskSessions   DeskSession[]     @relation("DeskUser")
  sessionsEnded  DeskSession[]     @relation("DeskEnder")
  batchSessions  BatchSession[]    @relation("BatchUser")
  batchInitiated BatchSession[]    @relation("BatchInitiator")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Leads & call chain (spec §4, §5)
// ─────────────────────────────────────────────────────────────

enum LeadTier {
  AGENT
  SR_AGENT
  CLOSER

  @@map("lead_tier")
}

enum LeadStatus {
  NEW
  PENDING_ROUTING
  IN_PROGRESS
  QUALIFIED
  CLOSED_WON
  CLOSED_LOST
  INVALID

  @@map("lead_status")
}

model Lead {
  id              Int        @id @default(autoincrement())
  createdById     Int        @map("created_by")
  assignedToId    Int?       @map("assigned_to")
  currentTier     LeadTier   @default(AGENT) @map("current_tier")
  status          LeadStatus @default(NEW)
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  primaryPhone    String     @map("primary_phone")
  address         String?
  city            String?
  state           String?
  zip             String?
  sourceProvider  String?    @map("source_provider")
  rawProviderData Json?      @map("raw_provider_data")
  workStatusId    Int?       @map("work_status_id") // tier-specific disposition; reset on routing
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  createdBy      User             @relation("LeadCreator", fields: [createdById], references: [id])
  assignedTo     User?            @relation("LeadAssignee", fields: [assignedToId], references: [id])
  workStatus     TierStatus?      @relation(fields: [workStatusId], references: [id])
  phones         LeadPhone[]
  queueEntries   RoutingQueue[]
  routingHistory RoutingHistory[]
  activities     Activity[]
  enrichment     LeadEnrichment?
  customValues   LeadCustomValue[]
  comments       LeadComment[]
  accessBlocks   LeadAccessBlock[]

  @@index([assignedToId, status])
  @@index([currentTier, status])
  @@index([primaryPhone])
  @@map("leads")
}

model LeadPhone {
  id        Int     @id @default(autoincrement())
  leadId    Int     @map("lead_id")
  phone     String // E.164 — normalized on input, enforced in service layer
  lineType  String? @map("line_type")
  isPrimary Boolean @default(false) @map("is_primary")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@map("lead_phones")
}

enum TransferPoint {
  T1_TO_SS
  T2_TO_CLOSER
  T3_SEND_BACK

  @@map("transfer_point")
}

enum QueueStatus {
  PENDING
  ROUTED

  @@map("queue_status")
}

model RoutingQueue {
  id            Int           @id @default(autoincrement())
  leadId        Int           @map("lead_id")
  transferPoint TransferPoint @map("transfer_point")
  raisedById    Int           @map("raised_by")
  status        QueueStatus   @default(PENDING)
  routedById    Int?          @map("routed_by")
  routedToId    Int?          @map("routed_to")
  agingAlertAt  DateTime?     @map("aging_alert_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  routedAt      DateTime?     @map("routed_at")

  lead     Lead  @relation(fields: [leadId], references: [id])
  raisedBy User  @relation("QueueRaisedBy", fields: [raisedById], references: [id])
  routedBy User? @relation("QueueRoutedBy", fields: [routedById], references: [id])
  routedTo User? @relation("QueueRoutedTo", fields: [routedToId], references: [id])

  @@index([status, transferPoint])
  @@map("routing_queue")
}

// APPEND-ONLY — UPDATE/DELETE blocked by DB trigger (see migration append_only_guards)
model RoutingHistory {
  id            Int           @id @default(autoincrement())
  leadId        Int           @map("lead_id")
  transferPoint TransferPoint @map("transfer_point")
  fromUserId    Int?          @map("from_user")
  toUserId      Int           @map("to_user")
  routedById    Int           @map("routed_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([createdAt])
  @@map("routing_history")
}

enum ActivityType {
  CALL
  NOTE
  STATUS_CHANGE
  TRANSFER_REQUEST

  @@map("activity_type")
}

model Activity {
  id            Int          @id @default(autoincrement())
  leadId        Int          @map("lead_id")
  userId        Int          @map("user_id")
  type          ActivityType
  detail        String
  deskSessionId Int?         @map("desk_session_id") // which seat the call was worked from
  createdAt     DateTime     @default(now()) @map("created_at")

  lead        Lead         @relation(fields: [leadId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  deskSession DeskSession? @relation(fields: [deskSessionId], references: [id])

  @@index([leadId, createdAt])
  @@map("activities")
}

// ─────────────────────────────────────────────────────────────
// Provider search & cost control (spec Phase 2, §8 NFRs)
// ─────────────────────────────────────────────────────────────

model SearchCache {
  id        Int      @id @default(autoincrement())
  searchKey String   @unique @map("search_key") // normalized: lowercased, sorted key=value pairs
  provider  String
  response  Json
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("search_cache")
}

model ProviderSetting {
  id                     Int      @id @default(autoincrement())
  code                   String   @unique // e.g. MOCK, ENDATO, TRESTLE
  displayName            String   @map("display_name")
  description            String?
  isActive               Boolean  @default(false) @map("is_active")
  costPerSearchCents     Int      @default(0) @map("cost_per_search_cents")
  dailySpendCapCents     Int      @default(0) @map("daily_spend_cap_cents") // 0 = no cap
  dailyRequestLimit      Int      @default(0) @map("daily_request_limit") // max live API calls/day, 0 = unlimited
  cacheTtlHours          Int      @default(720) @map("cache_ttl_hours")
  // Credentials live server-side ONLY — never returned by the API (spec §8 NFR:
  // provider keys never reach the browser). GET exposes hasCredentials/last4.
  apiKey                 String?  @map("api_key")
  apiSecret              String?  @map("api_secret")
  baseUrl                String?  @map("base_url")
  websiteUrl             String?  @map("website_url")
  signupUrl              String?  @map("signup_url")
  docsUrl                String?  @map("docs_url")
  howToGet               String?  @map("how_to_get") // onboarding steps shown in the UI
  permittedUseAttestation String? @map("permitted_use_attestation") // FCRA/DPPA/GLBA guardrail (spec §8)
  attestedById           Int?     @map("attested_by")
  attestedAt             DateTime? @map("attested_at")
  createdAt              DateTime @default(now()) @map("created_at")

  usage ProviderUsage[]

  @@map("provider_settings")
}

model ProviderUsage {
  id         Int      @id @default(autoincrement())
  providerId Int      @map("provider_id")
  userId     Int?     @map("user_id")
  searchKey  String   @map("search_key")
  cacheHit   Boolean  @default(false) @map("cache_hit")
  costCents  Int      @default(0) @map("cost_cents")
  createdAt  DateTime @default(now()) @map("created_at")

  provider ProviderSetting @relation(fields: [providerId], references: [id])

  @@index([providerId, createdAt])
  @@map("provider_usage")
}

// ─────────────────────────────────────────────────────────────
// Audit, notifications, system control (spec §7, §9)
// ─────────────────────────────────────────────────────────────

// APPEND-ONLY — UPDATE/DELETE blocked by DB trigger (see migration append_only_guards)
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  detail    Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@map("audit_log")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String
  title     String
  body      String?
  leadId    Int?     @map("lead_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum SystemStatus {
  ACTIVE
  LOCKED

  @@map("system_status")
}

model SystemState {
  id        Int          @id @default(1)
  status    SystemStatus @default(ACTIVE)
  updatedBy Int?         @map("updated_by")
  updatedAt DateTime     @default(now()) @map("updated_at")

  @@map("system_state")
}

model RecoveryKey {
  id        Int      @id @default(autoincrement())
  keyHash   String   @map("key_hash") // argon2 — raw key shown exactly once
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  isActive  Boolean  @default(true) @map("is_active")

  @@map("recovery_key")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ─────────────────────────────────────────────────────────────
// Lead enrichment (sections A/C/D/E of the enrichment spec)
// ─────────────────────────────────────────────────────────────

enum EnrichmentStatus {
  PENDING
  PARTIAL
  COMPLETE
  FAILED

  @@map("enrichment_status")
}

model LeadEnrichment {
  id             Int              @id @default(autoincrement())
  leadId         Int              @unique @map("lead_id")
  providerData   Json?            @map("provider_data") // section A — normalized personEnrichment
  geoData        Json?            @map("geo_data") // section C — geoEnrichment (localTimeNow derived on read)
  complianceData Json?            @map("compliance_data") // section D — DNC/litigator/consent + callable gate
  intelligence   Json? // section E — computed in-house; reproducible from the blobs above
  enrichedAt     DateTime         @default(now()) @map("enriched_at")
  enrichedById   Int              @map("enriched_by")
  enrichmentCost Decimal          @default(0) @map("enrichment_cost") @db.Decimal(10, 2) // dollars spent this run
  status         EnrichmentStatus @default(PENDING)

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrichedBy User @relation(fields: [enrichedById], references: [id])

  @@map("lead_enrichment")
}

model ScoreWeight {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  weight    Int
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("score_weights")
}

// ─────────────────────────────────────────────────────────────
// Custom fields, comments, per-lead access control
// ─────────────────────────────────────────────────────────────

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN

  @@map("custom_field_type")
}

// Admin-defined WORK statuses, one list per tier (Agent / Sr Agent / Closer).
// These are dispositions the assigned user sets while working the lead —
// separate from the pipeline status (NEW/PENDING_ROUTING/…), which only the
// routing engine may change (spec §4 invariant 1).
model TierStatus {
  id        Int      @id @default(autoincrement())
  tier      LeadTier
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  leads Lead[]

  @@unique([tier, label])
  @@map("tier_statuses")
}

// Admin-defined process fields ("name as per process they ask and fill").
model CustomFieldDef {
  id        Int             @id @default(autoincrement())
  label     String
  fieldType CustomFieldType @default(TEXT) @map("field_type")
  options   Json? // DROPDOWN choices
  sortOrder Int             @default(0) @map("sort_order")
  isActive  Boolean         @default(true) @map("is_active")
  createdBy Int             @map("created_by")
  createdAt DateTime        @default(now()) @map("created_at")

  values LeadCustomValue[]

  @@map("custom_field_defs")
}

// Values stay editable — updated whenever an agent confirms details with the
// customer. Every change writes an activity row for the timeline.
model LeadCustomValue {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  fieldId   Int      @map("field_id")
  value     String
  updatedBy Int      @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead  Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  field CustomFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, fieldId])
  @@map("lead_custom_values")
}

// Comments: manager, admin, and the people who worked the lead (enforced in service).
model LeadComment {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  userId    Int      @map("user_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_comments")
}

// Admin can revoke a specific person's access to a specific lead.
// Blocks apply to everyone except manage_lead_access holders (admins).
model LeadAccessBlock {
  id          Int      @id @default(autoincrement())
  leadId      Int      @map("lead_id")
  userId      Int      @map("user_id")
  reason      String
  blockedById Int      @map("blocked_by")
  createdAt   DateTime @default(now()) @map("created_at")

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  blockedBy User @relation("BlockedBy", fields: [blockedById], references: [id])

  @@unique([leadId, userId])
  @@map("lead_access_blocks")
}

// ─────────────────────────────────────────────────────────────
// Quick batch-ID sessions (work as yourself on a colleague's screen)
// ─────────────────────────────────────────────────────────────

enum BatchSessionEnd {
  EXPIRED // hit the admin-set time limit
  ENDED   // ended manually from the screen it ran on
  REVOKED // killed by the identity owner or an admin

  @@map("batch_session_end")
}

model BatchSession {
  id            Int              @id @default(autoincrement())
  userId        Int              @map("user_id") // whose identity is active
  initiatedById Int              @map("initiated_by") // whose login the screen had
  sid           String           @unique // cache session key — deleting it kills the token
  startedAt     DateTime         @default(now()) @map("started_at")
  expiresAt     DateTime         @map("expires_at")
  endedAt       DateTime?        @map("ended_at")
  endReason     BatchSessionEnd? @map("end_reason")

  user        User @relation("BatchUser", fields: [userId], references: [id])
  initiatedBy User @relation("BatchInitiator", fields: [initiatedById], references: [id])

  @@index([userId, endedAt])
  @@map("batch_sessions")
}

// ─────────────────────────────────────────────────────────────
// Desk / batch-ID sessions (shared-seat call floor)
// ─────────────────────────────────────────────────────────────

// A physical seat/desk. Its code is the "Batch ID" people type when they sit.
model Desk {
  id        Int      @id @default(autoincrement())
  code      String   @unique // e.g. DESK-01 — the batch id
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  sessions DeskSession[]

  @@map("desks")
}

enum DeskSessionEnd {
  CLOCK_OUT // user ended their own shift
  TAKEOVER  // someone else sat down and entered the batch id
  FORCED    // force-completed by an admin

  @@map("desk_session_end")
}

model DeskSession {
  id        Int             @id @default(autoincrement())
  deskId    Int             @map("desk_id")
  userId    Int             @map("user_id")
  startedAt DateTime        @default(now()) @map("started_at")
  endedAt   DateTime?       @map("ended_at")
  endReason DeskSessionEnd? @map("end_reason")
  endedById Int?            @map("ended_by")

  desk    Desk       @relation(fields: [deskId], references: [id])
  user    User       @relation("DeskUser", fields: [userId], references: [id])
  endedBy User?      @relation("DeskEnder", fields: [endedById], references: [id])
  calls   Activity[]

  @@index([deskId, endedAt])
  @@index([userId, endedAt])
  @@map("desk_sessions")
}

// In-house DNC/opt-out list — AUTHORITATIVE, always checked before external scrubs.
model DncOptout {
  id        Int      @id @default(autoincrement())
  phone     String   @unique // E.164
  reason    String
  addedById Int      @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  addedBy User @relation(fields: [addedById], references: [id])

  @@map("dnc_optout")
}
